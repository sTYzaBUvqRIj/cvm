# ============================================================================
# comparison.cvma — Three-Way Integer and Float Comparisons (-1, 0, +1)
# ============================================================================
.registers 6

CONST_I32  r0, 50
CONST_I32  r1, 20
CMP_I32    r2, r0, r1         # r0 > r1  -> r2 = +1

CONST_I32  r3, 100
CMP_I32    r4, r0, r3         # r0 < r3  -> r4 = -1

# Add results: (+1) + (-1) = 0
ADD_I32    r5, r2, r4
RETURN     r5                 # Returns 0
