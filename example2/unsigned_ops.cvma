# ============================================================================
# unsigned_ops.cvma — Unsigned Integer Arithmetic & Ordered Float Comparison
# ============================================================================
# Demonstrates:
#   1. DIV_U32  - Unsigned 32-bit integer division
#   2. REM_U32  - Unsigned 32-bit remainder
#   3. DIV_U64  - Unsigned 64-bit integer division
#   4. REM_U64  - Unsigned 64-bit remainder
#   5. CMP_F32_GT - Ordered float comparison (returns +2 on NaN)
# ============================================================================

.registers 8

# 1. DIV_U32: 0xFFFFFFFF / 2 = 2147483647 (0x7FFFFFFF)
# Loading 0xFFFFFFFF into r0
CONST_I64   r0, 4294967295
CONST_I32   r1, 2
DIV_U32     r2, r0, r1

# 2. REM_U32: 17 % 5 = 2
CONST_I32   r3, 17
CONST_I32   r4, 5
REM_U32     r5, r3, r4

# 3. CMP_F32_GT: Compare 5.0f > 3.0f -> returns 1
CONST_F32   r6, 5.0
CONST_F32   r7, 3.0
CMP_F32_GT  r0, r6, r7

# Add r2 (2147483647) + r5 (2) + r0 (1) = 2147483650 (0x7FFFFFF2)
ADD_I32     r2, r2, r5
ADD_I32     r2, r2, r0

RETURN      r2
