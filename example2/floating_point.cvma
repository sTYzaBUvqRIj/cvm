# ============================================================================
# floating_point.cvma — Double Precision Floating Point Arithmetic
# ============================================================================
.registers 8

# Calculate: (1.5 + 2.5) * (4.0 - 1.0) = 4.0 * 3.0 = 12.0
CONST_F64  r0, 1.5
CONST_F64  r1, 2.5
ADD_F64    r2, r0, r1         # r2 = 4.0

CONST_F64  r3, 4.0
CONST_F64  r4, 1.0
SUB_F64    r5, r3, r4         # r5 = 3.0

MUL_F64    r6, r2, r5         # r6 = 12.0
F64_TO_I32 r7, r6             # r7 = 12

RETURN     r7                 # Returns 12
