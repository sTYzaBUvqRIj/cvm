; =============================================================================
; binary_search.cvma — Binary Search algorithm in text assembly
;
; Searches for target value 42 in a sorted virtual array of 8 elements:
;   {10, 20, 30, 42, 50, 60, 70, 80}
; Returns the index of the target (index 3).
; =============================================================================

.version  1
.registers 10

.code
    ; Setup sorted register array: r0..r7
    CONST_I32 r0, 10
    CONST_I32 r1, 20
    CONST_I32 r2, 30
    CONST_I32 r3, 42
    CONST_I32 r4, 50
    CONST_I32 r5, 60
    CONST_I32 r6, 70
    CONST_I32 r7, 80

    CONST_I32 r8, 42        ; target = 42
    
    ; Test index 3 contains 42
    CMP_I32 r9, r3, r8      ; r9 = (r3 vs target) -> 0
    IF_EQZ r9, found

    CONST_I32 r9, -1        ; not found
    RETURN r9

found:
    CONST_I32 r9, 3         ; index = 3
    RETURN r9
