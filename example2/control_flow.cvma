# ============================================================================
# control_flow.cvma — Branching, Loops, and Labels
# ============================================================================
.registers 6

# Sum odd numbers from 1 to 19 (1 + 3 + 5 + ... + 19 = 100)
CONST_I32  r0, 1          # i = 1
CONST_I32  r1, 20         # limit = 20
CONST_I32  r2, 0          # sum = 0
CONST_I32  r3, 2          # step = 2

loop_start:
ADD_I32    r2, r2, r0     # sum += i
ADD_I32    r0, r0, r3     # i += 2
IF_LT      r0, r1, loop_start # if i < 20 goto loop_start

RETURN     r2             # Returns 100
